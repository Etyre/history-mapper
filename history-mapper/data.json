    {
      "id": "8a7878af-21d7-44ee-82ab-d5ff8259b585",
      "title": "The LessWrong and Bay Area Rationality Community is growing",
      "startYear": 2007,
      "endYear": 2021,
      "spanType": "Subculture",
      "subEvents": [
        {
          "id": "ca1ae7b1-acc6-4ec7-a23e-40d64a60592c",
          "date": 2007,
          "label": "Yudkowsky begins blogging daily on OvercomingBias"
        },
        {
          "id": "1bd40b61-9256-4383-94c0-2bc00a6fb0af",
          "date": 2009,
          "label": "LessWrong started, Yudkowsky finishes the Sequences"
        },
        {
          "id": "9d12163a-52dd-4fb3-ad86-28e5e2107033",
          "date": 2012,
          "label": "CFAR is founded"
        },
        {
          "id": "009ea92c-c627-4bf8-ae23-7b93a5f9db1d",
          "date": 2021,
          "label": "By 2021 most of the energy that had driven the growth of the rationality community has been used up, and new young people are more likely to identify with the more professionalized EA and AI safety brands. The community-driven funding model is largely displaced by institutional philanthropy."
        }
      ],
      "causalImpacts": [
        {
          "id": "34336f70-248c-4cb1-8cd7-a8f6d56a6fcd",
          "targetSpanId": "caeee581-afd3-451d-bf68-a96d033ed042",
          "sourceAttachment": "middle",
          "targetAttachment": "middle",
          "annotation": "LessWrong was one of the original three intellectual communities that fed into early EA, along with the Oxford utilitarians who were influenced by Parfit, and GiveWell coming out of Birdgewater"
        },
        {
          "id": "7ff2dcc4-8b6b-43d1-95cb-af3381ec158b",
          "targetSpanId": "867cdaa2-c377-46f9-9acf-3c93e5398008",
          "sourceAttachment": "middle",
          "targetAttachment": "middle",
          "annotation": "The ideas that Yudkowsky promoted, and which were discussed on LessWrong, lead directly to the founding of OpenAI: Elon Musk reads Superintelligence and attends the Puerto Rico conference, and then founds OpenAI with Sam Altman as a counterweight to Google DeepMind"
        }
      ]
    },
