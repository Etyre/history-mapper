          "id": "1bd40b61-9256-4383-94c0-2bc00a6fb0af",
          "date": 2009,
          "label": "Yudkowsky finishes the Sequences"
        },
        {
          "id": "9d12163a-52dd-4fb3-ad86-28e5e2107033",
          "date": 2012,
          "label": "CFAR is founded"
        },
        {
          "id": "009ea92c-c627-4bf8-ae23-7b93a5f9db1d",
          "date": 2021,
          "label": "By 2021 most of the energy that had driven the growth of the rationality community had been used up, and new young people are more likely to associate with the EA and AI safety communities. The community-driven funding model is largely displaced by institutional philanthropy."
        }
      ],
      "causalImpacts": [
        {
          "id": "34336f70-248c-4cb1-8cd7-a8f6d56a6fcd",
          "targetSpanId": "caeee581-afd3-451d-bf68-a96d033ed042",
          "sourceAttachment": "middle",
          "targetAttachment": "middle",
          "annotation": "LessWrong was one of the original three intellectual communities that fed into early EA, along with the Oxford utilitarians who were influenced by Parfit, and GiveWell coming out of Birdgewater"
        },
        {
          "id": "7ff2dcc4-8b6b-43d1-95cb-af3381ec158b",
          "targetSpanId": "867cdaa2-c377-46f9-9acf-3c93e5398008",
          "sourceAttachment": "middle",
          "targetAttachment": "middle",
          "annotation": "The ideas that Yudkowsky promoted, and which were discussed on LessWrong lead to the founding of OpenAI"
        }
      ]
    },
